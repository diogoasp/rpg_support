[Unit]
Description=One Piece RPG Docker Compose
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/onepiece-rpg/app
ExecStart=/usr/bin/docker compose -f compose.yml -f compose.production.yml --profile tunnel up -d
ExecStop=/usr/bin/docker compose -f compose.yml -f compose.production.yml --profile tunnel stop
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
